<script>
(function(){
  var s=document.getElementById('ls'),b=document.getElementById('lb'),p=document.getElementById('lp'),done=false;
  function go(v){v=Math.min(v,100);b.style.width=v+'%';p.textContent=Math.round(v)+'%';if(v>=100&&!done){done=true;setTimeout(function(){s.classList.add('hide');setTimeout(function(){s.style.display='none';},420);},180);}}
  var steps=[15,30,50,68,80,90,96,100],i=0;
  var t=setInterval(function(){if(i<steps.length)go(steps[i++]);else clearInterval(t);},90);
  window.addEventListener('load',function(){clearInterval(t);go(100);});
})();
var obs=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting)x.target.classList.add('visible');});},{threshold:0.08});
document.querySelectorAll('.reveal').forEach(function(el){obs.observe(el);});
function toggleDay(el){el.classList.toggle('open');}
function toggleFaq(el){el.classList.toggle('faq-open');}
</script>
