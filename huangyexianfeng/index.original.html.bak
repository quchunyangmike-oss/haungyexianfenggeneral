<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin:3px;"><img src="data:image/jpeg;base64," style="width:100%;aspect-ratio:3/4;object-fit:cover;filter:brightness(0.88);" alt=""><img src="data:image/jpeg;base64," style="width:100%;aspect-ratio:3/4;object-fit:cover;filter:brightness(0.88);" alt=""><img src="data:image/jpeg;base64," style="width:100%;aspect-ratio:3/4;object-fit:cover;filter:brightness(0.88);" alt=""></div>
</div>
<div style="background:#1a3320;"><div style="max-width:480px;margin:0 auto;padding:32px 20px 14px;" class="reveal"><div style="font-size:10px;letter-spacing:4px;color:#e8631a;font-weight:700;margin-bottom:6px;">D3 · 上午</div><h2 style="font-family:'Noto Serif SC',serif;font-size:clamp(22px,6vw,34px);font-weight:900;color:#faf8f4;line-height:1.2;margin-bottom:0;">腰旗 <span style='color:#e8631a'>橄榄球</span> · 速度激情</h2></div><div style="display:flex;gap:3px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;"><img src="data:image/jpeg;base64," style="height:230px;width:auto;object-fit:cover;flex-shrink:0;filter:brightness(0.85);" alt=""><img src="data:image/jpeg;base64," style="height:230px;width:auto;object-fit:cover;flex-shrink:0;filter:brightness(0.85);" alt=""><img src="data:image/jpeg;base64," style="height:230px;width:auto;object-fit:cover;flex-shrink:0;filter:brightness(0.85);" alt=""><img src="data:image/jpeg;base64," style="height:230px;width:auto;object-fit:cover;flex-shrink:0;filter:brightness(0.85);" alt=""></div>
